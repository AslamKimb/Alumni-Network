# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
# @sensitive=false
BETTER_AUTH_URL=

# @type=url
# @sensitive=false
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Comma-separated emails granted admin while no active admin exists.
# Not a secret: the address is returned in every session payload, and varlock
# refuses to send a response that contains a sensitive value.
# @type=string
# @sensitive=false
ADMIN_EMAILS=
